l <- function(x,y) {
(1/6) * 1/(x+y+1) * 1/choose(7-(x+y), 2)
}
likelihoods <- data.frame(c(0:6))
View(likelihoods)
likelihoods <- data.frame(c(0:5))
likelihoods$nPhi1 <- c((0,0,1,1,2,2))
likelihoods$nPhi1 <- c(0,0,1,1,2,2)
likelihoods <- data.frame(c(0:8))
likelihoods$nPhi1 <- c(0,0,0,1,1,1,2,2,2)
likelihoods <- data.frame(c(0,0,0,1,1,1,2,2,2))
colnames(likelihoods) <- c("nPhi1")
likelihoods$nPhi2 <- c(0,1,2,0,1,2,0,1,2)
lSVO <- function(x,y) {
(1/6) * 1/(x+y+1) * 1/choose(7-(x+y), 2)
}
lSOV <- function(x,y) {
if (x<=1) {
(1/6) * 1/(x+y+1) * 1/choose(7-(x+y), 2)
} else {
NaN
}
}
likelihoods$SVO <- lSVO(likelihoods$nPhi1, likelihoods$nPhi2)
likelihoods$SOV <- lSOV(likelihoods$nPhi1, likelihoods$nPhi2)
lSOV <- function(x,y) {
if (x<2) {
(1/6) * 1/(x+y+1) * 1/choose(7-(x+y), 2)
} else {
NaN
}
}
likelihoods$SOV <- lSOV(likelihoods$nPhi1, likelihoods$nPhi2)
l <- function(x,y) {
(1/6) * 1/(x+y+1) * 1/choose(7-(x+y), 2)
}
likelihoods$SVO <- l(likelihoods$nPhi1, likelihoods$nPhi2)
likelihoods$SOV <- ifelse(likelihoods$nPhi1<=1, l(likelihoods$nPhi1, likelihoods$nPhi2), NaN)
View(likelihoods)
likelihoods.long <- gather(likelihoods, grammar, likelihood, SVO:SOV, factor_key=TRUE)
View(likelihoods.long)
