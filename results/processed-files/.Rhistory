levels(likelihoods.long$grammar) <- c("SVO","SOV")
likelihoods.long$nPhi2 <- factor(likelihoods.long$nPhi2)
likelihoods.long$nPhi <- paste(likelihoods.long$nPhi1, " ", likelihoods.long$nPhi2)
likelihoods.long$nPhi <- paste("n1=", likelihoods.long$nPhi1, " ", "n2=", likelihoods.long$nPhi2)
levels(likelihoods.long$grammar) <- c("SVO","SOV")
